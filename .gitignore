# Playwright's transient run artifacts: a failed run's screenshots and traces are
# evidence for the run that made them, not for the next one.
test-results/

# A clone of this repository is a neighbour, not a directory of this one (M423). It was
# committed once as a submodule pointer with no .gitmodules file, and every proof that walks
# the tree then read the app twice. The rule lives in scripts/lib/appTree.mjs; this line is
# the belt to that pair of braces.
football-os/

# Local agent/tool state (memory, session logs) — not part of the shipped app.
# .workbuddy/ carries this workspace's cross-session memory; it is hidden from every census
# (appTree's isHiddenName) but kept out of the product repository all the same, like -ai above.
.workbuddy-ai/
.workbuddy/

# Maven build output for the Spring Cloud skeleton under services/ (M1036).
services/**/target/

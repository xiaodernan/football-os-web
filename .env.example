# Football OS live-AI configuration template — copy to .env and fill in what applies.
# .env is gitignored; this file NEVER holds a real key.
#
# Two families of settings, deliberately split:
#   LLM_* (no VITE_ prefix) — read by the server-side proxy only, never shipped to the browser.
#     LLM_API_KEY    any OpenAI-compatible bearer key you choose to use
#     LLM_BASE_URL   the provider's base URL (path MUST end in /v1)
#     LLM_MODEL      whatever instruct-model the provider serves as
#   CACHE_* (no VITE_ prefix) — optional Spring-cache service live wire, never shipped.
#     CACHE_SERVICE_BASE  absolute base URL of your football-os-cache service (e.g. http://127.0.0.1:8083)
#                         — unset/empty → the Spring wire panel prints "not armed" (never fake).
#                         Server-side probe only; the browser never receives the URL.
#   SPRING_*_BASE (no VITE_ prefix) — optional per-service fleet health probe, never shipped.
#     SPRING_REGISTRY_BASE / SPRING_CONFIG_BASE / SPRING_GATEWAY_BASE / SPRING_LEAGUE_BASE
#     SPRING_DISCIPLINE_BASE / SPRING_CACHE_BASE / SPRING_MESSAGING_BASE
#                         absolute base URL of each service you run (e.g. http://127.0.0.1:8083)
#                         — unset/empty → that service's tile prints "not armed" (never fake).
#                         Server-side probe only (GET {base}/actuator/health, 1.2s abort);
#                         the browser never receives any URL you set here.
#   VITE_*          — public, non-secret build-time flags the browser may legitimately see.
#     VITE_LLM_ENABLED  "true" arms the live path from the chat screen; unset/empty degrades to
#                       the deterministic briefing (nothing crosses the wire).
#     VITE_LLM_MODEL    the model NAME only, shown to the user in the chat UI chip.
#                       Never a key, never a base URL with a secret in it.
#
# Without VITE_LLM_ENABLED=true every message is answered locally and the browser never
# reaches /api/llm/chat at all.
LLM_API_KEY=
LLM_BASE_URL=https://wkapi.pro/v1
LLM_MODEL=gpt-6-sol
CACHE_SERVICE_BASE=
SPRING_REGISTRY_BASE=
SPRING_CONFIG_BASE=
SPRING_GATEWAY_BASE=
SPRING_LEAGUE_BASE=
SPRING_DISCIPLINE_BASE=
SPRING_CACHE_BASE=
SPRING_MESSAGING_BASE=
VITE_LLM_ENABLED=
VITE_LLM_MODEL=gpt-6-sol
